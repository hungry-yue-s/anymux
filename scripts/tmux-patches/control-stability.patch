+static void
+log_stderr_prefix(const char *prefix)
+{
+	struct timeval	 tv;
+	struct tm	 tm;
+	time_t		 sec;
+	char		 buf[32];
+
+	gettimeofday(&tv, NULL);
+	sec = tv.tv_sec;
+	if (gmtime_r(&sec, &tm) != NULL &&
+	    strftime(buf, sizeof buf, "%Y-%m-%dT%H:%M:%S", &tm) != 0)
+		fprintf(stderr, "%s.%03dZ tmux[%ld]: %s", buf,
+		    (int)(tv.tv_usec / 1000), (long)getpid(), prefix);
+	else
+		fprintf(stderr, "%lld.%06d tmux[%ld]: %s",
+		    (long long)tv.tv_sec, (int)tv.tv_usec, (long)getpid(),
+		    prefix);
+}
+
 /* Log a critical error with error string and die. */
